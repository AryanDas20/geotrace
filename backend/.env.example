# Firebase Admin credentials: prefer the hosting platform's service identity.
# Local development only: set GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=

# Server-only AI key. Never put this value in src/config.js or browser JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# API settings
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-hosted-domain.example
MAX_UPLOAD_BYTES=26214400
EXPOSE_API_DOCS=false
LOG_LEVEL=INFO

# Reference index built by backend/build_index.py
REFERENCE_INDEX_PATH=index/reference.faiss
REFERENCE_METADATA_PATH=index/reference_metadata.json
REFERENCE_PHOTOS_DIR=reference_photos
REFERENCE_INDEX_DIR=index
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
